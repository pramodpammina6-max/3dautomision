# MongoDB (local: mongodb://127.0.0.1:27017, prod: your Atlas SRV string)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=3dautomision

# 32+ random chars: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars

# OpenAI (floor plan JSON generation + AI furnishing). Leave empty to run in demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Separate backend API
BACKEND_PORT=4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
